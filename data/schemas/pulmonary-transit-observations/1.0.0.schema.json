{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RegineWendt/MEHLISSA/data/schemas/pulmonary-transit-observations/1.0.0.schema.json",
  "title": "PCQ-C2 normalized whole-pulmonary transit observations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset", "units", "observation_model", "participants", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "dataset": {"$ref": "#/$defs/dataset"},
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["age", "mean_bolus_transit_time"],
      "properties": {"age": {"const": "year"}, "mean_bolus_transit_time": {"const": "s"}}
    },
    "observation_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "transit_start", "transit_end", "capillary_only_direct_comparison", "derived_pulmonary_blood_volume_is_independent_evidence"],
      "properties": {
        "status": {"const": "blocked-observation-model"},
        "transit_start": {"const": "pulmonary_trunk"},
        "transit_end": {"const": "left_atrium"},
        "capillary_only_direct_comparison": {"const": "forbidden"},
        "derived_pulmonary_blood_volume_is_independent_evidence": {"const": false}
      }
    },
    "participants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/participant"}},
    "limitations": {"$ref": "#/$defs/nonempty_strings"}
  },
  "$defs": {
    "positive": {"type": "number", "exclusiveMinimum": 0},
    "nonempty_strings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "measurement_family", "candidate_id", "data_origin", "participant_identifier_policy", "generation_note"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"},
        "measurement_family": {"const": "pcq_whole_pulmonary_transit"},
        "candidate_id": {"const": "PCQ-SRC-C-003"},
        "data_origin": {"enum": ["synthetic_test_fixture", "measured_source"]},
        "participant_identifier_policy": {"const": "study_pseudonym_only"},
        "generation_note": {"type": "string", "minLength": 1}
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participant_id", "age_years", "phenotype", "body_position", "state", "measurement_method", "mean_bolus_transit_time_s", "repeatability_coefficient", "tracer_retention_relative_bias_sensitivity", "uncertainty_basis"],
      "properties": {
        "participant_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "age_years": {"type": "number", "minimum": 20, "maximum": 40},
        "phenotype": {"const": "healthy_control"},
        "body_position": {"const": "supine"},
        "state": {"const": "rest"},
        "measurement_method": {"const": "rubidium_82_first_pass_PET"},
        "mean_bolus_transit_time_s": {"$ref": "#/$defs/positive"},
        "repeatability_coefficient": {"type": "number", "minimum": 0.172, "maximum": 1},
        "tracer_retention_relative_bias_sensitivity": {"const": 0.25},
        "uncertainty_basis": {"enum": ["source_supplied", "protocol_floor", "larger_of_source_and_protocol_floor"]}
      }
    }
  }
}

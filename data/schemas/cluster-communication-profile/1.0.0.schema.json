{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mehlissa:schema:cluster-communication-profile:1.0.0",
  "title": "MEHLISSA cluster communication profile",
  "description": "Versioned bounded cluster topology, relay, routing, and multi-hop reference.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "cluster", "reference_case", "validity", "sources", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profile": {"$ref": "#/$defs/profile"},
    "cluster": {"$ref": "#/$defs/cluster"},
    "reference_case": {"$ref": "#/$defs/reference_case"},
    "validity": {"$ref": "#/$defs/validity"},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "version": {"$ref": "#/$defs/version"},
        "title": {"type": "string", "minLength": 1}
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "role"],
      "properties": {
        "device_id": {"$ref": "#/$defs/id"},
        "role": {"enum": ["endpoint", "relay", "collector", "gateway"]}
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "source_device_id", "target_device_id", "latency_seconds", "energy_per_attempt_j", "repeating_outcomes"],
      "properties": {
        "kind": {"const": "scheduled_one_hop_link"},
        "id": {"$ref": "#/$defs/id"},
        "source_device_id": {"$ref": "#/$defs/id"},
        "target_device_id": {"$ref": "#/$defs/id"},
        "latency_seconds": {"type": "number", "minimum": 0},
        "energy_per_attempt_j": {"type": "number", "minimum": 0},
        "repeating_outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["delivered", "lost", "corrupted"]}
        }
      }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "maximum_hops", "members", "links"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "maximum_hops": {"type": "integer", "minimum": 1, "maximum": 64},
        "members": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/member"}},
        "links": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/link"}}
      }
    },
    "reference_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_device_id", "target_device_id", "strategy", "expected_route_device_ids", "expected_total_latency_seconds", "expected_total_link_energy_j"],
      "properties": {
        "source_device_id": {"$ref": "#/$defs/id"},
        "target_device_id": {"$ref": "#/$defs/id"},
        "strategy": {"enum": ["fewest_hops", "lowest_total_latency"]},
        "expected_route_device_ids": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/id"}
        },
        "expected_total_latency_seconds": {"type": "number", "minimum": 0},
        "expected_total_link_energy_j": {"type": "number", "minimum": 0}
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["population", "physiological_state", "evidence_class", "description"],
      "properties": {
        "population": {"type": "string", "minLength": 1},
        "physiological_state": {"type": "string", "minLength": 1},
        "evidence_class": {"enum": ["software_test_surrogate", "literature_parameterized", "externally_derived", "hypothesis"]},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "citation", "location", "license", "role"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "citation": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1}
      }
    }
  }
}

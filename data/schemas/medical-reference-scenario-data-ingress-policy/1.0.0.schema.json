{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RegineWendt/MEHLISSA/data/schemas/medical-reference-scenario-data-ingress-policy/1.0.0.schema.json",
  "title": "MEHLISSA MRSQ-1.3 data-ingress policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy", "source_contract", "ingress_boundary", "readiness_gates", "synthetic_qualification", "decision"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "program", "version", "created_date", "status", "parent_protocol", "participant_files_opened", "validation_outcomes_inspected", "clinical_use"],
      "properties": {
        "id": {"const": "MRSQ-1.3"},
        "program": {"const": "MRSQ-1"},
        "version": {"const": "1.0.0"},
        "created_date": {"type": "string", "format": "date"},
        "status": {"const": "synthetic-ingress-qualified-measured-ingress-blocked"},
        "parent_protocol": {"$ref": "#/$defs/file_hash"},
        "participant_files_opened": {"const": false},
        "validation_outcomes_inspected": {"const": false},
        "clinical_use": {"const": false}
      }
    },
    "source_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository_id", "revision", "participant_assets", "metadata_columns", "curve_columns", "volume_columns", "aortic_selector", "region_components", "frame_duration_state"],
      "properties": {
        "provider": {"const": "Hugging Face"},
        "repository_id": {"const": "DEPICT-RH/Multimodal-HC"},
        "revision": {"pattern": "^[0-9a-f]{40}$"},
        "participant_assets": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/asset"}},
        "metadata_columns": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}},
        "curve_columns": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string"}},
        "volume_columns": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string"}},
        "aortic_selector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task_prefix", "label_name", "erosion_iterations"],
          "properties": {
            "task_prefix": {"const": "aortavois"},
            "label_name": {"const": "aorta"},
            "erosion_iterations": {"const": 0}
          }
        },
        "region_components": {"type": "object", "minProperties": 4, "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}},
        "frame_duration_state": {"const": "BLOCKED-combined-readouts-publish-midpoints-without-duration"}
      }
    },
    "ingress_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_first", "authorization_before_file_open", "measured_data_repository_policy", "quarantine_policy", "direct_identifier_fields", "output_policy", "opaque_linkage", "required_decay_reference"],
      "properties": {
        "manifest_first": {"const": true},
        "authorization_before_file_open": {"const": true},
        "measured_data_repository_policy": {"const": "forbidden"},
        "quarantine_policy": {"const": "explicit-absolute-existing-root-outside-repository"},
        "direct_identifier_fields": {"type": "array", "minItems": 12, "uniqueItems": true, "items": {"type": "string"}},
        "output_policy": {"const": "aggregate-metadata-only-no-source-pseudonym-or-raw-value"},
        "opaque_linkage": {"const": "run-scoped-sha256-with-private-manifest-salt"},
        "required_decay_reference": {"enum": ["injection_time_decay_corrected", "scan_time_not_decay_corrected"]}
      }
    },
    "readiness_gates": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/gate"}},
    "synthetic_qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_manifest", "families", "measured_evidence", "physiological_evidence", "negative_controls"],
      "properties": {
        "fixture_manifest": {"type": "string", "minLength": 1},
        "families": {"const": ["administration", "aortic_input", "organ_tac", "region_volume"]},
        "measured_evidence": {"const": false},
        "physiological_evidence": {"const": false},
        "negative_controls": {"type": "integer", "minimum": 10}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synthetic_ingress", "measured_ingress", "blockers", "next_increment", "allowed_claim"],
      "properties": {
        "synthetic_ingress": {"const": "PASS"},
        "measured_ingress": {"const": "BLOCKED"},
        "blockers": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "next_increment": {"const": "MRSQ-1.4 executable source-disjoint FDG/PET candidate"},
        "allowed_claim": {"type": "string", "minLength": 40}
      }
    }
  },
  "$defs": {
    "file_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"pattern": "^[0-9a-f]{64}$"}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "size_bytes", "git_blob_id", "content_sha256", "access_state"],
      "properties": {
        "role": {"enum": ["administration", "aortic_input", "organ_tac", "region_volume"]},
        "path": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "git_blob_id": {"pattern": "^[0-9a-f]{40}$"},
        "content_sha256": {"const": "pending-authorized-download-before-parse"},
        "access_state": {"const": "blocked"}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "reason"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"enum": ["PASS", "BLOCKED"]},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mehlissa.org/schemas/campaign/1.0.0.schema.json",
  "title": "MEHLISSA UX-4 derived-experiment campaign",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign", "base_scenario", "design", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"$ref": "#/$defs/nonempty"}
      }
    },
    "base_scenario": {
      "type": "string",
      "minLength": 6,
      "pattern": "^[^/\\\\].*\\.json$"
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicates", "sweeps", "paired_comparisons"],
      "properties": {
        "replicates": {"$ref": "#/$defs/replicate_plan"},
        "sweeps": {
          "type": "array",
          "maxItems": 16,
          "items": {"$ref": "#/$defs/sweep"}
        },
        "paired_comparisons": {
          "type": "array",
          "maxItems": 16,
          "items": {"$ref": "#/$defs/paired_comparison"}
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/nonempty"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "nonempty": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "collector_count": {"type": "integer", "minimum": 1, "maximum": 1000000000},
    "replicate_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "first_seed"],
      "properties": {
        "count": {"type": "integer", "minimum": 0, "maximum": 100},
        "first_seed": {"$ref": "#/$defs/seed"}
      }
    },
    "sweep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parameter", "values", "replicates", "first_seed"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "parameter": {"const": "run.collector_count"},
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/collector_count"}
        },
        "replicates": {"type": "integer", "minimum": 1, "maximum": 100},
        "first_seed": {"$ref": "#/$defs/seed"}
      }
    },
    "paired_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parameter", "baseline", "comparison", "replicates", "first_seed"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "parameter": {"const": "run.collector_count"},
        "baseline": {"$ref": "#/$defs/collector_count"},
        "comparison": {"$ref": "#/$defs/collector_count"},
        "replicates": {"type": "integer", "minimum": 1, "maximum": 100},
        "first_seed": {"$ref": "#/$defs/seed"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mehlissa.org/schemas/campaign-result/1.0.0.schema.json",
  "title": "MEHLISSA UX-4 aggregate campaign result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign", "run_count", "runs", "sensitivity_hooks", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "source_manifest", "source_sha256", "base_scenario"],
      "properties": {
        "id": {"$ref": "#/$defs/nonempty"},
        "title": {"$ref": "#/$defs/nonempty"},
        "source_manifest": {"$ref": "#/$defs/nonempty"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "base_scenario": {"$ref": "#/$defs/nonempty"}
      }
    },
    "run_count": {"type": "integer", "minimum": 1},
    "runs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/run"}},
    "sensitivity_hooks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/hook"}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/nonempty"}
    }
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metric": {"type": ["number", "null"], "minimum": 0.0, "maximum": 1.0},
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "design", "group", "role", "replicate_index", "seed", "parameter", "value", "manifest_path", "manifest_sha256", "result_path", "result_sha256", "detected", "assembled", "sensitivity", "specificity"],
      "properties": {
        "id": {"$ref": "#/$defs/nonempty"},
        "design": {"enum": ["replicate", "sweep", "paired_comparison"]},
        "group": {"$ref": "#/$defs/nonempty"},
        "role": {"enum": ["member", "baseline", "comparison"]},
        "replicate_index": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer", "minimum": 0},
        "parameter": {"const": "run.collector_count"},
        "value": {"type": "integer", "minimum": 1},
        "manifest_path": {"$ref": "#/$defs/nonempty"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "result_path": {"$ref": "#/$defs/nonempty"},
        "result_sha256": {"$ref": "#/$defs/sha256"},
        "detected": {"type": "boolean"},
        "assembled": {"type": "boolean"},
        "sensitivity": {"$ref": "#/$defs/metric"},
        "specificity": {"$ref": "#/$defs/metric"}
      }
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter", "response_metrics", "qualification"],
      "properties": {
        "parameter": {"const": "run.collector_count"},
        "response_metrics": {
          "type": "array",
          "prefixItems": [
            {"const": "detected"},
            {"const": "assembled"},
            {"const": "sensitivity"},
            {"const": "specificity"}
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "qualification": {"$ref": "#/$defs/nonempty"}
      }
    }
  }
}

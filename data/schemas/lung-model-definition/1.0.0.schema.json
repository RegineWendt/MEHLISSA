{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mehlissa:schema:lung-model-definition:1.0.0",
  "title": "MEHLISSA lung model definition",
  "description": "Executable lung-model selection with validity, evidence, source, unit, and optional external-data provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "definition", "variant", "component", "timing", "validity", "sources", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "version": {"$ref": "#/$defs/version"},
        "title": {"type": "string", "minLength": 1}
      }
    },
    "variant": {"type": "string", "enum": ["effective_compartment", "regional_circulation"]},
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "model_id", "entry_port_id", "exit_port_id", "return_target_model_id", "return_target_port_id"],
      "properties": {
        "name": {"$ref": "#/$defs/id"},
        "model_id": {"$ref": "#/$defs/id"},
        "entry_port_id": {"$ref": "#/$defs/id"},
        "exit_port_id": {"$ref": "#/$defs/id"},
        "return_target_model_id": {"$ref": "#/$defs/id"},
        "return_target_port_id": {"$ref": "#/$defs/id"}
      }
    },
    "timing": {
      "oneOf": [
        {"$ref": "#/$defs/compartment_timing"},
        {"$ref": "#/$defs/regional_timing"}
      ]
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["population", "physiological_state", "evidence_class", "description"],
      "properties": {
        "population": {"type": "string", "minLength": 1},
        "physiological_state": {"type": "string", "minLength": 1},
        "evidence_class": {"type": "string", "enum": ["software_test_surrogate", "literature_parameterized", "externally_derived"]},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "citation", "url", "license", "role"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "citation": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1}
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "external_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "path", "sha256", "format", "coordinate_system", "length_unit", "flow_unit", "transformations"],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "format": {"type": "string", "minLength": 1},
        "coordinate_system": {"type": "string", "minLength": 1},
        "length_unit": {"type": "string", "minLength": 1},
        "flow_unit": {"type": "string", "minLength": 1},
        "transformations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"variant": {"const": "effective_compartment"}}},
      "then": {"properties": {"timing": {"$ref": "#/$defs/compartment_timing"}}}
    },
    {
      "if": {"properties": {"variant": {"const": "regional_circulation"}}},
      "then": {"properties": {"timing": {"$ref": "#/$defs/regional_timing"}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "duration_s": {"type": "number", "minimum": 1e-9},
    "compartment_timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transit_time_s"],
      "properties": {"transit_time_s": {"$ref": "#/$defs/duration_s"}}
    },
    "regional_timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regions"],
      "properties": {
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "transit_time_s"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "transit_time_s": {"$ref": "#/$defs/duration_s"}
            }
          }
        }
      }
    }
  }
}

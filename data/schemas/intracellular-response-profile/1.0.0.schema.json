{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mehlissa:schema:intracellular-response-profile:1.0.0",
  "title": "MEHLISSA intracellular ODE/SSA comparison profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "network", "ode_solver", "ssa_solver", "comparison_reference", "validity", "sources", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profile": {"$ref": "#/$defs/profile"},
    "network": {"$ref": "#/$defs/network"},
    "ode_solver": {"$ref": "#/$defs/ode"},
    "ssa_solver": {"$ref": "#/$defs/ssa"},
    "comparison_reference": {"$ref": "#/$defs/reference"},
    "validity": {"$ref": "#/$defs/validity"},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "positive": {"type": "number", "exclusiveMinimum": 0},
    "profile": {"type": "object", "additionalProperties": false, "required": ["id", "version", "title"], "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/version"}, "title": {"type": "string", "minLength": 1}}},
    "network": {
      "type": "object", "additionalProperties": false,
      "required": ["network_id", "topology", "messenger_activation_rate_s_1", "messenger_deactivation_rate_s_1", "effector_activation_rate_s_1", "effector_deactivation_rate_s_1", "response_threshold_fraction"],
      "properties": {
        "network_id": {"$ref": "#/$defs/id"}, "topology": {"const": "receptor_to_messenger_to_effector"},
        "messenger_activation_rate_s_1": {"$ref": "#/$defs/positive"},
        "messenger_deactivation_rate_s_1": {"type": "number", "minimum": 0},
        "effector_activation_rate_s_1": {"$ref": "#/$defs/positive"},
        "effector_deactivation_rate_s_1": {"type": "number", "minimum": 0},
        "response_threshold_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "ode": {"type": "object", "additionalProperties": false, "required": ["kind", "method", "integration_step_seconds", "maximum_integration_steps", "maximum_recorded_samples"], "properties": {"kind": {"const": "rk4_two_stage_intracellular"}, "method": {"const": "fixed_step_rk4"}, "integration_step_seconds": {"$ref": "#/$defs/positive"}, "maximum_integration_steps": {"type": "integer", "minimum": 1, "maximum": 10000000}, "maximum_recorded_samples": {"type": "integer", "minimum": 2, "maximum": 1000000}}},
    "ssa": {"type": "object", "additionalProperties": false, "required": ["kind", "method", "messenger_molecule_count", "effector_molecule_count", "maximum_reaction_events", "maximum_recorded_samples", "random_stream_policy"], "properties": {"kind": {"const": "gillespie_two_stage_intracellular"}, "method": {"const": "gillespie_direct_ssa"}, "messenger_molecule_count": {"type": "integer", "minimum": 1, "maximum": 1000000000}, "effector_molecule_count": {"type": "integer", "minimum": 1, "maximum": 1000000000}, "maximum_reaction_events": {"type": "integer", "minimum": 1, "maximum": 100000000}, "maximum_recorded_samples": {"type": "integer", "minimum": 2, "maximum": 1000000}, "random_stream_policy": {"const": "one_named_stream_per_cell"}}},
    "knot": {"type": "object", "additionalProperties": false, "required": ["offset_seconds", "bound_fraction"], "properties": {"offset_seconds": {"type": "number", "minimum": 0}, "bound_fraction": {"$ref": "#/$defs/fraction"}}},
    "gates": {"type": "object", "additionalProperties": false, "required": ["expected_ode_messenger_fraction", "expected_ode_effector_fraction", "expected_ode_response_seconds", "ode_fraction_tolerance", "ode_time_tolerance_seconds", "maximum_ssa_messenger_mean_error", "maximum_ssa_effector_mean_error"], "properties": {"expected_ode_messenger_fraction": {"$ref": "#/$defs/fraction"}, "expected_ode_effector_fraction": {"$ref": "#/$defs/fraction"}, "expected_ode_response_seconds": {"$ref": "#/$defs/positive"}, "ode_fraction_tolerance": {"$ref": "#/$defs/positive"}, "ode_time_tolerance_seconds": {"$ref": "#/$defs/positive"}, "maximum_ssa_messenger_mean_error": {"$ref": "#/$defs/positive"}, "maximum_ssa_effector_mean_error": {"$ref": "#/$defs/positive"}}},
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "observation_time_seconds", "initial_active_messenger_fraction", "initial_active_effector_fraction", "receptor_trajectory", "master_seed", "stream_prefix", "population_size", "acceptance_gates"],
      "properties": {"request_id": {"$ref": "#/$defs/id"}, "observation_time_seconds": {"$ref": "#/$defs/positive"}, "initial_active_messenger_fraction": {"$ref": "#/$defs/fraction"}, "initial_active_effector_fraction": {"$ref": "#/$defs/fraction"}, "receptor_trajectory": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/knot"}}, "master_seed": {"type": "integer", "minimum": 0}, "stream_prefix": {"$ref": "#/$defs/id"}, "population_size": {"type": "integer", "minimum": 2, "maximum": 1000000}, "acceptance_gates": {"$ref": "#/$defs/gates"}}
    },
    "validity": {"type": "object", "additionalProperties": false, "required": ["population", "physiological_state", "evidence_class", "description"], "properties": {"population": {"type": "string", "minLength": 1}, "physiological_state": {"type": "string", "minLength": 1}, "evidence_class": {"const": "software_test_surrogate"}, "description": {"type": "string", "minLength": 1}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["id", "citation", "location", "license", "role"], "properties": {"id": {"$ref": "#/$defs/id"}, "citation": {"type": "string", "minLength": 1}, "location": {"type": "string", "minLength": 1}, "license": {"type": "string", "minLength": 1}, "role": {"type": "string", "minLength": 1}}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mehlissa:schema:log-record:1.0.0",
  "title": "MEHLISSA structured run-log record",
  "description": "One JSON Lines record emitted during a MEHLISSA simulation run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "timestamp_utc",
    "simulation_time_ns",
    "level",
    "source",
    "event",
    "message"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "timestamp_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "simulation_time_ns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "level": {
      "type": "string",
      "enum": ["debug", "info", "warning", "error"]
    },
    "source": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "event": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,127}$"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "id"],
      "properties": {
        "code": {
          "type": "integer",
          "enum": [1001, 2001, 2002, 2003, 2004, 2005, 3001, 3002, 4001, 4002, 4003, 5001, 5002, 9001]
        },
        "id": {
          "type": "string",
          "pattern": "^MEHLISSA-E[0-9]{4}$"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mehlissa:schema:molecular-channel-profile:1.0.0",
  "title": "MEHLISSA molecular-channel profile",
  "description": "Strict configuration and capillary-bound reference case for an interchangeable molecular-channel implementation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "implementation", "reference_case", "validity", "sources", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "version": {"$ref": "#/$defs/version"},
        "title": {"type": "string", "minLength": 1}
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "model_id", "diffusion_coefficient_m2_s", "first_order_degradation_rate_s_1", "maximum_receiver_radius_to_separation_ratio"],
      "properties": {
        "kind": {"const": "analytical_free_diffusion_3d"},
        "model_id": {"$ref": "#/$defs/id"},
        "diffusion_coefficient_m2_s": {"type": "number", "exclusiveMinimum": 0},
        "first_order_degradation_rate_s_1": {"type": "number", "minimum": 0},
        "maximum_receiver_radius_to_separation_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.25}
      }
    },
    "reference_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "signal_id", "compatible_capillary_definition_id", "capillary_region_id", "separation_fraction_of_diameter", "receiver_radius_fraction_of_separation", "emitted_amount_mol", "observation_time_mode"],
      "properties": {
        "request_id": {"$ref": "#/$defs/id"},
        "signal_id": {"$ref": "#/$defs/id"},
        "compatible_capillary_definition_id": {"$ref": "#/$defs/id"},
        "capillary_region_id": {"$ref": "#/$defs/id"},
        "separation_fraction_of_diameter": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "receiver_radius_fraction_of_separation": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.25},
        "emitted_amount_mol": {"type": "number", "exclusiveMinimum": 0},
        "observation_time_mode": {"const": "analytical_peak"}
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["population", "physiological_state", "evidence_class", "description"],
      "properties": {
        "population": {"type": "string", "minLength": 1},
        "physiological_state": {"type": "string", "minLength": 1},
        "evidence_class": {"type": "string", "enum": ["software_test_surrogate", "literature_parameterized", "externally_derived"]},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "citation", "location", "license", "role"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "citation": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1}
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
  }
}

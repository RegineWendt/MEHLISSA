{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mehlissa:schema:transport-observation-report:1.0.0",
  "title": "MEHLISSA transport observation report",
  "description": "Bounded trajectories, measurements, aggregates and extraction results for a body transport run.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model", "summary", "configuration", "truncation", "measurement_counts", "measurement_records", "trajectory_records", "population_snapshots", "extractions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["injected_particle_count", "active_particle_count", "extracted_particle_count", "transition_count"],
      "properties": {
        "injected_particle_count": {"$ref": "#/$defs/count"},
        "active_particle_count": {"$ref": "#/$defs/count"},
        "extracted_particle_count": {"$ref": "#/$defs/count"},
        "transition_count": {"$ref": "#/$defs/count"}
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trajectory_selection", "trajectory_particle_limit", "maximum_trajectory_records", "maximum_measurement_records", "aggregate_interval_ns", "maximum_aggregate_records", "measurement_sites"],
      "properties": {
        "trajectory_selection": {"type": "string", "enum": ["none", "all", "first_n"]},
        "trajectory_particle_limit": {"$ref": "#/$defs/count"},
        "maximum_trajectory_records": {"$ref": "#/$defs/count"},
        "maximum_measurement_records": {"$ref": "#/$defs/count"},
        "aggregate_interval_ns": {"$ref": "#/$defs/count"},
        "maximum_aggregate_records": {"$ref": "#/$defs/count"},
        "measurement_sites": {
          "type": "array",
          "items": {"$ref": "#/$defs/measurement_site"}
        }
      }
    },
    "truncation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trajectories", "measurements", "aggregates"],
      "properties": {
        "trajectories": {"type": "boolean"},
        "measurements": {"type": "boolean"},
        "aggregates": {"type": "boolean"}
      }
    },
    "measurement_counts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["site_id", "segment_id", "kind", "particle_count"],
        "properties": {
          "site_id": {"type": "string", "minLength": 1},
          "segment_id": {"type": "string", "minLength": 1},
          "kind": {"$ref": "#/$defs/measurement_kind"},
          "particle_count": {"$ref": "#/$defs/count"}
        }
      }
    },
    "measurement_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["time_ns", "site_id", "segment_id", "kind", "particle_id"],
        "properties": {
          "time_ns": {"$ref": "#/$defs/count"},
          "site_id": {"type": "string", "minLength": 1},
          "segment_id": {"type": "string", "minLength": 1},
          "kind": {"$ref": "#/$defs/measurement_kind"},
          "particle_id": {"type": "integer", "minimum": 1}
        }
      }
    },
    "trajectory_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["time_ns", "particle_id", "action", "segment_id"],
        "properties": {
          "time_ns": {"$ref": "#/$defs/count"},
          "particle_id": {"type": "integer", "minimum": 1},
          "action": {"type": "string", "enum": ["injected", "entered_segment", "extracted"]},
          "segment_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "population_snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["time_ns", "segments"],
        "properties": {
          "time_ns": {"$ref": "#/$defs/count"},
          "segments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["segment_id", "particle_count"],
              "properties": {
                "segment_id": {"type": "string", "minLength": 1},
                "particle_count": {"$ref": "#/$defs/count"}
              }
            }
          }
        }
      }
    },
    "extractions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scheduled_time_ns", "processed_time_ns", "segment_id", "requested_particle_count", "extracted_particle_count"],
        "properties": {
          "scheduled_time_ns": {"$ref": "#/$defs/count"},
          "processed_time_ns": {"$ref": "#/$defs/count"},
          "segment_id": {"type": "string", "minLength": 1},
          "requested_particle_count": {
            "oneOf": [
              {"type": "null"},
              {"type": "integer", "minimum": 1}
            ]
          },
          "extracted_particle_count": {"$ref": "#/$defs/count"}
        }
      }
    }
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "measurement_kind": {"type": "string", "enum": ["sample", "gateway"]},
    "measurement_site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "segment_id", "kind"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "segment_id": {"type": "string", "minLength": 1},
        "kind": {"$ref": "#/$defs/measurement_kind"}
      }
    }
  }
}

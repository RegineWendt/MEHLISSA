{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RegineWendt/MEHLISSA/data/schemas/pulmonary-hemodynamics-observations/1.0.0.schema.json",
  "title": "PCQ-H normalized participant hemodynamics",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset", "units", "participants", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "dataset": {"$ref": "#/$defs/dataset"},
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["age", "workload", "cardiac_output", "pressure", "heart_rate"],
      "properties": {
        "age": {"const": "year"},
        "workload": {"const": "W"},
        "cardiac_output": {"const": "L/min"},
        "pressure": {"const": "mmHg"},
        "heart_rate": {"const": "1/min"}
      }
    },
    "participants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/participant"}},
    "limitations": {"$ref": "#/$defs/nonempty_strings"}
  },
  "$defs": {
    "positive": {"type": "number", "exclusiveMinimum": 0},
    "nonempty_strings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "measurement_family", "candidate_id", "data_origin", "participant_identifier_policy", "generation_note"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"},
        "measurement_family": {"const": "pcq_hemodynamics"},
        "candidate_id": {"const": "PCQ-SRC-H-001"},
        "data_origin": {"enum": ["synthetic_test_fixture", "measured_source"]},
        "participant_identifier_policy": {"const": "study_pseudonym_only"},
        "generation_note": {"type": "string", "minLength": 1}
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ordinal", "state", "workload_W", "cardiac_output_L_min", "mean_pulmonary_arterial_pressure_mmHg", "pulmonary_arterial_wedge_pressure_mmHg", "mPAP_standard_uncertainty_mmHg", "PAWP_standard_uncertainty_mmHg", "cardiac_output_relative_standard_uncertainty", "uncertainty_basis"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "ordinal": {"type": "integer", "minimum": 0},
        "state": {"enum": ["rest", "exercise"]},
        "workload_W": {"type": "number", "minimum": 0},
        "cardiac_output_L_min": {"$ref": "#/$defs/positive"},
        "mean_pulmonary_arterial_pressure_mmHg": {"$ref": "#/$defs/positive"},
        "pulmonary_arterial_wedge_pressure_mmHg": {"$ref": "#/$defs/positive"},
        "mPAP_standard_uncertainty_mmHg": {"type": "number", "minimum": 2},
        "PAWP_standard_uncertainty_mmHg": {"type": "number", "minimum": 3},
        "cardiac_output_relative_standard_uncertainty": {"type": "number", "minimum": 0.1, "maximum": 1},
        "uncertainty_basis": {"enum": ["source_supplied", "protocol_floor", "larger_of_source_and_protocol_floor"]},
        "systolic_pulmonary_arterial_pressure_mmHg": {"$ref": "#/$defs/positive"},
        "diastolic_pulmonary_arterial_pressure_mmHg": {"$ref": "#/$defs/positive"},
        "heart_rate_per_minute": {"$ref": "#/$defs/positive"}
      },
      "allOf": [
        {"if": {"required": ["systolic_pulmonary_arterial_pressure_mmHg"]}, "then": {"required": ["diastolic_pulmonary_arterial_pressure_mmHg", "heart_rate_per_minute"]}},
        {"if": {"required": ["diastolic_pulmonary_arterial_pressure_mmHg"]}, "then": {"required": ["systolic_pulmonary_arterial_pressure_mmHg", "heart_rate_per_minute"]}},
        {"if": {"required": ["heart_rate_per_minute"]}, "then": {"required": ["systolic_pulmonary_arterial_pressure_mmHg", "diastolic_pulmonary_arterial_pressure_mmHg"]}}
      ]
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participant_id", "age_years", "phenotype", "body_position", "cardiac_output_method", "protocol", "stages"],
      "properties": {
        "participant_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "age_years": {"type": "number", "minimum": 20, "maximum": 40},
        "phenotype": {"const": "healthy_control"},
        "body_position": {"enum": ["supine", "recumbent"]},
        "cardiac_output_method": {"type": "string", "minLength": 1},
        "protocol": {"const": "incremental_exercise"},
        "stages": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/stage"}}
      }
    }
  }
}

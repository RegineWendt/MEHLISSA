{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mehlissa:schema:capillary-exchange-profile:1.0.0",
  "title": "MEHLISSA capillary substance-exchange profile",
  "description": "Strict staged partition of a substance amount among blood, endothelium, interstitium, and cell compartments for one compatible capillary bed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "compatible_model_id", "unmatched_substance_policy", "substance_rules", "validity", "sources", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "version": {"$ref": "#/$defs/version"},
        "title": {"type": "string", "minLength": 1}
      }
    },
    "compatible_model_id": {"$ref": "#/$defs/id"},
    "unmatched_substance_policy": {"const": "pass_through"},
    "substance_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["substance_id", "blood_to_endothelium_fraction", "endothelium_to_interstitium_fraction", "interstitium_to_cell_fraction"],
        "properties": {
          "substance_id": {"$ref": "#/$defs/id"},
          "blood_to_endothelium_fraction": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
          "endothelium_to_interstitium_fraction": {"$ref": "#/$defs/fraction"},
          "interstitium_to_cell_fraction": {"$ref": "#/$defs/fraction"}
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["population", "physiological_state", "evidence_class", "description"],
      "properties": {
        "population": {"type": "string", "minLength": 1},
        "physiological_state": {"type": "string", "minLength": 1},
        "evidence_class": {"type": "string", "enum": ["software_test_surrogate", "literature_parameterized", "externally_derived"]},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "citation", "location", "license", "role"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "citation": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1}
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "fraction": {"type": "number", "minimum": 0, "maximum": 1}
  }
}

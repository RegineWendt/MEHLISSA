{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mehlissa.org/schemas/pulmonary-lobar-perfusion-validation/1.0.0.schema.json",
  "title": "MEHLISSA pulmonary lobar perfusion validation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "validation", "protocol", "sources", "series", "limitations"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "model_definition_id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "model_definition_id": { "type": "string", "minLength": 1 }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_absolute_lobar_error_percentage_points",
        "maximum_rmse_percentage_points",
        "maximum_right_lung_error_percentage_points",
        "decision_rule",
        "execution_status"
      ],
      "properties": {
        "maximum_absolute_lobar_error_percentage_points": { "type": "number", "exclusiveMinimum": 0 },
        "maximum_rmse_percentage_points": { "type": "number", "exclusiveMinimum": 0 },
        "maximum_right_lung_error_percentage_points": { "type": "number", "exclusiveMinimum": 0 },
        "decision_rule": { "type": "string", "minLength": 1 },
        "execution_status": {
          "const": "thresholds_declared_from_source_reconstruction_sensitivity_before_executable_evaluation"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "citation", "url", "license", "measurement_method", "cohort",
          "sample_size", "body_position", "data_access", "cohort_independence"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "citation": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "license": { "const": "CC-BY-4.0" },
          "measurement_method": { "type": "string", "minLength": 1 },
          "cohort": { "type": "string", "minLength": 1 },
          "sample_size": { "type": "integer", "minimum": 1 },
          "body_position": { "const": "supine" },
          "data_access": { "type": "string", "minLength": 1 },
          "cohort_independence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source_id", "reconstruction", "normalization_policy", "perfusion_fractions"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source_id": { "type": "string", "minLength": 1 },
          "reconstruction": {
            "enum": ["without_attenuation_correction", "with_attenuation_correction"]
          },
          "normalization_policy": {
            "const": "renormalize_reported_rounded_fractions_to_unit_sum"
          },
          "perfusion_fractions": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["bed_id", "side", "value"],
              "properties": {
                "bed_id": { "type": "string", "minLength": 1 },
                "side": { "enum": ["left", "right"] },
                "value": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
              }
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mehlissa.example/schemas/pulmonary-zero-dimensional-validation/1.0.0",
  "title": "MEHLISSA pulmonary zero-dimensional validation case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "validation", "protocol", "sources", "conditions", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "model_definition_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "model_definition_id": {"type": "string", "minLength": 1}
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_absolute_z_score", "decision_rule", "execution_status"],
      "properties": {
        "maximum_absolute_z_score": {"type": "number", "exclusiveMinimum": 0},
        "decision_rule": {"type": "string", "minLength": 1},
        "execution_status": {"const": "protocol_locked_before_repository_evaluation"}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "citation", "url", "license", "measurement_method"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "citation": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "license": {"type": "string", "minLength": 1},
          "measurement_method": {"type": "string", "minLength": 1}
        }
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/condition"}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "inputObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mean_si", "standard_deviation_si", "unit", "acceptance_role"],
      "properties": {
        "mean_si": {"type": "number", "exclusiveMinimum": 0},
        "standard_deviation_si": {"type": "number", "exclusiveMinimum": 0},
        "unit": {"type": "string", "minLength": 1},
        "acceptance_role": {"const": "input"}
      }
    },
    "endpointObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mean_si", "standard_deviation_si", "unit", "acceptance_role"],
      "properties": {
        "mean_si": {"type": "number", "exclusiveMinimum": 0},
        "standard_deviation_si": {"type": "number", "exclusiveMinimum": 0},
        "unit": {"type": "string", "minLength": 1},
        "acceptance_role": {"enum": ["required", "diagnostic"]}
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_id", "description", "scope", "boundary_policy", "observations"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "scope": {"enum": ["declared_scope", "near_scope_crosscheck", "stress_test"]},
        "boundary_policy": {"enum": ["locked_left_atrial_pressure", "measured_wedge_pressure"]},
        "observations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cardiac_output", "mean_pulmonary_arterial_pressure"],
          "properties": {
            "cardiac_output": {
              "allOf": [
                {"$ref": "#/$defs/inputObservation"},
                {"properties": {"unit": {"const": "m3/s"}}}
              ]
            },
            "pulmonary_arterial_wedge_pressure": {
              "allOf": [
                {"$ref": "#/$defs/inputObservation"},
                {"properties": {"unit": {"const": "Pa"}}}
              ]
            },
            "mean_pulmonary_arterial_pressure": {
              "allOf": [
                {"$ref": "#/$defs/endpointObservation"},
                {"properties": {"unit": {"const": "Pa"}}}
              ]
            },
            "pulmonary_arterial_compliance": {
              "allOf": [
                {"$ref": "#/$defs/endpointObservation"},
                {"properties": {"unit": {"const": "m3/Pa"}}}
              ]
            },
            "rc_time_constant": {
              "allOf": [
                {"$ref": "#/$defs/endpointObservation"},
                {"properties": {"unit": {"const": "s"}}}
              ]
            }
          }
        }
      }
    }
  }
}

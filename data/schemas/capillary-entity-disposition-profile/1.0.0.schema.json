{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mehlissa:schema:capillary-entity-disposition-profile:1.0.0",
  "title": "MEHLISSA capillary entity-disposition profile",
  "description": "Strict mapping from sampled capillary interaction outcomes to explicit terminal owners.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "compatible_model_id", "compatible_observation_profile_id", "random_stream_name", "source_port_id", "targets", "validity", "sources", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "version": {"$ref": "#/$defs/version"},
        "title": {"type": "string", "minLength": 1}
      }
    },
    "compatible_model_id": {"$ref": "#/$defs/id"},
    "compatible_observation_profile_id": {"$ref": "#/$defs/id"},
    "random_stream_name": {"$ref": "#/$defs/id"},
    "source_port_id": {"$ref": "#/$defs/id"},
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retained", "adhered", "extravasated"],
      "properties": {
        "retained": {"$ref": "#/$defs/target"},
        "adhered": {"$ref": "#/$defs/target"},
        "extravasated": {"$ref": "#/$defs/target"}
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["population", "physiological_state", "evidence_class", "description"],
      "properties": {
        "population": {"type": "string", "minLength": 1},
        "physiological_state": {"type": "string", "minLength": 1},
        "evidence_class": {"const": "software_test_surrogate"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "citation", "location", "license", "role"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "citation": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1}
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "compartment_id"],
      "properties": {
        "model_id": {"$ref": "#/$defs/id"},
        "compartment_id": {"$ref": "#/$defs/id"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mehlissa.example/schemas/pulmonary-zero-dimensional-multipoint-validation/1.0.0",
  "title": "MEHLISSA subject-level pulmonary zero-dimensional multipoint validation case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "validation", "protocol", "sources", "subjects", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "model_definition_id", "evidence_status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "model_definition_id": {"type": "string", "minLength": 1},
        "evidence_status": {"enum": ["measured_validation", "synthetic_test_only"]}
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_stage_count", "parameter_fitting", "subject_identifier_policy", "decision_rule", "execution_status"],
      "properties": {
        "minimum_stage_count": {"type": "integer", "minimum": 3},
        "parameter_fitting": {"const": "forbidden"},
        "subject_identifier_policy": {"const": "study_pseudonym_only"},
        "decision_rule": {"type": "string", "minLength": 1},
        "execution_status": {"const": "protocol_locked_before_repository_evaluation"}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "citation", "url", "license", "measurement_method", "data_access", "cohort_independence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "citation": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "license": {"type": "string", "minLength": 1},
          "measurement_method": {"type": "string", "minLength": 1},
          "data_access": {"type": "string", "minLength": 1},
          "cohort_independence": {"const": "confirmed_disjoint"}
        }
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/subject"}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "positiveNumber": {"type": "number", "exclusiveMinimum": 0},
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ordinal",
        "workload_watts",
        "cardiac_output_m3_per_s",
        "pulmonary_arterial_wedge_pressure_pa",
        "mean_pulmonary_arterial_pressure_pa"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "ordinal": {"type": "integer", "minimum": 0},
        "workload_watts": {"type": "number", "minimum": 0},
        "cardiac_output_m3_per_s": {"$ref": "#/$defs/positiveNumber"},
        "pulmonary_arterial_wedge_pressure_pa": {"$ref": "#/$defs/positiveNumber"},
        "mean_pulmonary_arterial_pressure_pa": {"$ref": "#/$defs/positiveNumber"},
        "systolic_pulmonary_arterial_pressure_pa": {"$ref": "#/$defs/positiveNumber"},
        "diastolic_pulmonary_arterial_pressure_pa": {"$ref": "#/$defs/positiveNumber"},
        "heart_rate_per_minute": {"$ref": "#/$defs/positiveNumber"}
      },
      "allOf": [
        {
          "if": {"required": ["systolic_pulmonary_arterial_pressure_pa"]},
          "then": {"required": ["diastolic_pulmonary_arterial_pressure_pa", "heart_rate_per_minute"]}
        },
        {
          "if": {"required": ["diastolic_pulmonary_arterial_pressure_pa"]},
          "then": {"required": ["systolic_pulmonary_arterial_pressure_pa", "heart_rate_per_minute"]}
        },
        {
          "if": {"required": ["heart_rate_per_minute"]},
          "then": {"required": ["systolic_pulmonary_arterial_pressure_pa", "diastolic_pulmonary_arterial_pressure_pa"]}
        }
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_id", "phenotype", "body_position", "cardiac_output_method", "stages"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "source_id": {"type": "string", "minLength": 1},
        "phenotype": {"const": "healthy_control"},
        "body_position": {"enum": ["supine", "semiupright", "upright"]},
        "cardiac_output_method": {"type": "string", "minLength": 1},
        "stages": {
          "type": "array",
          "minItems": 3,
          "items": {"$ref": "#/$defs/stage"}
        }
      }
    }
  }
}

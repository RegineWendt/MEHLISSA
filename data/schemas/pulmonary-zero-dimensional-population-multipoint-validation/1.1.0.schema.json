{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mehlissa.example/schemas/pulmonary-zero-dimensional-population-multipoint-validation/1.1.0",
  "title": "MEHLISSA published-population pulmonary zero-dimensional multipoint validation case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "validation", "protocol", "sources", "series", "limitations"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "model_definition_id", "evidence_status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "model_definition_id": {"type": "string", "minLength": 1},
        "evidence_status": {"const": "published_population_summary"}
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_stage_count",
        "parameter_fitting",
        "standard_deviation_multiplier",
        "decision_rule",
        "execution_status"
      ],
      "properties": {
        "minimum_stage_count": {"type": "integer", "minimum": 3},
        "parameter_fitting": {"const": "forbidden"},
        "standard_deviation_multiplier": {"type": "number", "exclusiveMinimum": 0},
        "decision_rule": {"type": "string", "minLength": 1},
        "execution_status": {"const": "protocol_locked_before_repository_evaluation"}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/series"}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "positiveNumber": {"type": "number", "exclusiveMinimum": 0},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "citation",
        "url",
        "license",
        "measurement_method",
        "data_access",
        "cohort_independence"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "citation": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "license": {"type": "string", "minLength": 1},
        "measurement_method": {"type": "string", "minLength": 1},
        "data_access": {"type": "string", "minLength": 1},
        "cohort_independence": {"const": "confirmed_disjoint"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mean", "unit"],
      "properties": {
        "mean": {"$ref": "#/$defs/positiveNumber"},
        "standard_deviation": {"$ref": "#/$defs/positiveNumber"},
        "confidence_interval_95_lower": {"$ref": "#/$defs/positiveNumber"},
        "confidence_interval_95_upper": {"$ref": "#/$defs/positiveNumber"},
        "unit": {"enum": ["mmHg", "L/min", "L/min/m2", "1/min"]}
      },
      "oneOf": [
        {"required": ["standard_deviation"]},
        {"required": ["confidence_interval_95_lower", "confidence_interval_95_upper"]}
      ]
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ordinal",
        "challenge_kind",
        "cardiac_flow",
        "pulmonary_arterial_wedge_pressure",
        "mean_pulmonary_arterial_pressure"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "ordinal": {"type": "integer", "minimum": 0},
        "challenge_kind": {"enum": ["rest", "passive_leg_raise", "exercise"]},
        "workload_watts_mean": {"type": "number", "minimum": 0},
        "cardiac_flow": {"$ref": "#/$defs/observation"},
        "pulmonary_arterial_wedge_pressure": {"$ref": "#/$defs/observation"},
        "mean_pulmonary_arterial_pressure": {"$ref": "#/$defs/observation"},
        "heart_rate": {"$ref": "#/$defs/observation"}
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "phenotype",
        "sample_size",
        "body_position",
        "cardiac_output_method",
        "statistic_kind",
        "flow_basis",
        "cohort_overlap",
        "stages"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "source_id": {"type": "string", "minLength": 1},
        "phenotype": {"const": "healthy_control"},
        "sample_size": {"type": "integer", "minimum": 1},
        "body_position": {"enum": ["supine", "semiupright", "upright"]},
        "cardiac_output_method": {"type": "string", "minLength": 1},
        "statistic_kind": {"enum": ["mean_standard_deviation", "mean_confidence_interval_95"]},
        "flow_basis": {"enum": ["absolute_cardiac_output", "cardiac_index"]},
        "reference_body_surface_area_m2": {"$ref": "#/$defs/positiveNumber"},
        "representative_age_years": {"$ref": "#/$defs/positiveNumber"},
        "cohort_overlap": {"const": "disjoint_from_other_series"},
        "stages": {
          "type": "array",
          "minItems": 3,
          "items": {"$ref": "#/$defs/stage"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"flow_basis": {"const": "cardiac_index"}}},
          "then": {"required": ["reference_body_surface_area_m2"]},
          "else": {"not": {"required": ["reference_body_surface_area_m2"]}}
        }
      ]
    }
  }
}

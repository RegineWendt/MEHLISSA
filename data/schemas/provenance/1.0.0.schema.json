{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mehlissa:schema:provenance:1.0.0",
  "title": "MEHLISSA run provenance manifest",
  "description": "Machine-readable evidence needed to identify and reproduce a MEHLISSA simulation run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment",
    "software",
    "platform",
    "random",
    "run"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema_version", "manifest"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "git_commit",
        "git_dirty",
        "build_type",
        "compiler"
      ],
      "properties": {
        "name": {
          "const": "MEHLISSA"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "git_commit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|unknown)$"
        },
        "git_dirty": {
          "type": "boolean"
        },
        "build_type": {
          "type": "string",
          "minLength": 1
        },
        "compiler": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture"],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "random": {
      "type": "object",
      "additionalProperties": false,
      "required": ["master_seed"],
      "properties": {
        "master_seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at_utc",
        "completed_at_utc",
        "status",
        "simulation_time_ns"
      ],
      "properties": {
        "started_at_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "completed_at_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "status": {
          "type": "string",
          "enum": ["completed", "failed", "aborted"]
        },
        "simulation_time_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      }
    }
  }
}

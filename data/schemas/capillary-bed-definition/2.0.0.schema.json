{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mehlissa:schema:capillary-bed-definition:2.0.0",
  "title": "MEHLISSA capillary-bed definition",
  "description": "Strict definition of a serial arteriole-capillary-venule surrogate with SI geometry, continuity flow, explicit perfused paths, and model-component ports.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "definition", "component", "network", "validity", "sources", "limitations"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "version": {"$ref": "#/$defs/version"},
        "title": {"type": "string", "minLength": 1}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "model_id", "entry_port_id", "exit_port_id", "return_target_model_id", "return_target_port_id"],
      "properties": {
        "name": {"$ref": "#/$defs/id"},
        "model_id": {"$ref": "#/$defs/id"},
        "entry_port_id": {"$ref": "#/$defs/id"},
        "exit_port_id": {"$ref": "#/$defs/id"},
        "return_target_model_id": {"$ref": "#/$defs/id"},
        "return_target_port_id": {"$ref": "#/$defs/id"}
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_parallel_path_count", "perfused_path_count", "volume_flow_rate_m3_s", "regions"],
      "properties": {
        "total_parallel_path_count": {"type": "integer", "minimum": 1},
        "perfused_path_count": {"type": "integer", "minimum": 1},
        "volume_flow_rate_m3_s": {"$ref": "#/$defs/positive_number"},
        "regions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {"$ref": "#/$defs/arteriole_region"},
            {"$ref": "#/$defs/capillary_region"},
            {"$ref": "#/$defs/venule_region"}
          ],
          "items": false
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["population", "physiological_state", "evidence_class", "description"],
      "properties": {
        "population": {"type": "string", "minLength": 1},
        "physiological_state": {"type": "string", "minLength": 1},
        "evidence_class": {"type": "string", "enum": ["software_test_surrogate", "literature_parameterized", "externally_derived"]},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "citation", "location", "license", "role"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "citation": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1}
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "positive_number": {"type": "number", "exclusiveMinimum": 0},
    "region_base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "length_m", "diameter_m", "parallel_vessel_count"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"type": "string"},
        "length_m": {"$ref": "#/$defs/positive_number"},
        "diameter_m": {"$ref": "#/$defs/positive_number"},
        "parallel_vessel_count": {"type": "integer", "minimum": 1}
      }
    },
    "arteriole_region": {
      "allOf": [
        {"$ref": "#/$defs/region_base"},
        {"properties": {"kind": {"const": "arteriole"}}}
      ]
    },
    "capillary_region": {
      "allOf": [
        {"$ref": "#/$defs/region_base"},
        {"properties": {"kind": {"const": "capillary"}}}
      ]
    },
    "venule_region": {
      "allOf": [
        {"$ref": "#/$defs/region_base"},
        {"properties": {"kind": {"const": "venule"}}}
      ]
    }
  }
}

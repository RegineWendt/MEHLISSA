{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mehlissa.example/schemas/paper1-release-candidate/1.0.0.schema.json",
  "title": "MEHLISSA Paper 1 release candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "candidate_id", "title", "status", "created_at_utc",
    "development_branch", "source", "suggested_tag", "protocol", "evidence_baseline",
    "measurements", "claim_registry", "quality", "boundaries"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "candidate_id": {"type": "string", "pattern": "^paper1-[a-z0-9-]+$"},
    "title": {"type": "string", "minLength": 10},
    "status": {"const": "review_candidate"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "development_branch": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "archive_path", "archive_sha256"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "archive_path": {"type": "string", "minLength": 1},
        "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "suggested_tag": {"type": "string", "minLength": 1},
    "protocol": {"$ref": "#/$defs/hashedArtifact"},
    "evidence_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrix", "schema", "family_count"],
      "properties": {
        "matrix": {"$ref": "#/$defs/hashedArtifact"},
        "schema": {"$ref": "#/$defs/hashedArtifact"},
        "family_count": {"const": 6}
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["experiment_id", "status", "report", "raw_archive", "interpretation"],
        "properties": {
          "experiment_id": {"enum": ["P1-E1-BODY-OBSERVATION", "P1-E2-M7-RESOURCE", "P1-E3-ACCESS-PARITY"]},
          "status": {"const": "complete"},
          "report": {"$ref": "#/$defs/hashedArtifact"},
          "raw_archive": {"$ref": "#/$defs/hashedArtifact"},
          "interpretation": {"type": "string", "minLength": 20}
        }
      }
    },
    "claim_registry": {"$ref": "#/$defs/hashedArtifact"},
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_status", "supported_ci_status", "checks"],
      "properties": {
        "local_status": {"enum": ["pending", "passed"]},
        "supported_ci_status": {"const": "pending_for_candidate_commit"},
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doi_minted", "final_tag_created", "manuscript_included", "clinical_claim"],
      "properties": {
        "doi_minted": {"const": false},
        "final_tag_created": {"const": false},
        "manuscript_included": {"const": false},
        "clinical_claim": {"const": false}
      }
    }
  },
  "$defs": {
    "hashedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
